# Copy this file to .env and fill values locally. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
OPENAI_API_KEY=your-ai-provider-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OPENAI_MODEL=gemini-2.5-flash

# Optional initial administrator account. Configure before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-unique-password
ADMIN_EMAIL=admin@example.com
# Set COOKIE_SECURE=1 only when served over HTTPS; keep 0 for localhost.
COOKIE_SECURE=0


# Daily AI request limits (successful requests)
DAILY_LIMIT_FREE=20
DAILY_LIMIT_PRO=200
